    "departureStationLat",
    "arrivalStation",
    "arrivalRegionCode",
    "arrivalStationLng",
    "arrivalStationLat",
    "distance",
    "departureTime",
    "departureTimeZone",
    "arrivalTime",
    "arrivalTimeZone",
    "seatType",
    "carNo",
    "seatNo",
    "priceCurrency",
    "priceValue",
    "passengerType",
    "passengerName",
    "waitingRoom",
    "ticketGate",
    "orderNo",
    "ticketNo",
