{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-passport:travel-snapshot:v1",
  "title": "Travel Pocket itinerary snapshot v1",
  "description": "Full replacement snapshot for the current UTC+8 ticket interface. Run repository semantic validation after JSON Schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timezone",
    "source",
    "revision",
    "updated_at",
    "expires_at",
    "trips"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "timezone": {
      "type": "string",
      "const": "Asia/Shanghai",
      "description": "All displayed times use UTC+8; timestamps themselves are UTC."
    },
    "source": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295,
      "description": "Strictly increases within a source stream."
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Provider snapshot update time; does not synchronize the device clock."
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Must be greater than updated_at; equality with device time means stale."
    },
    "trips": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/trip"
      },
      "description": "Full replacement list; [] clears the displayed itineraries."
    }
  },
  "$defs": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444799,
      "description": "UTC Unix seconds from 1970 through 2099; not milliseconds."
    },
    "optional_timestamp": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4102444799,
      "default": null
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4,
      "pattern": "^[A-Za-z0-9上下不东为乘以位信先准出分切划到加卡发取口可同回在场字定实对尚就州已座延待态息情拟持按换据接支数文新无时暂更期未机杭核桥检模正步海消添火片状用登知确票程站等绪虹行袋计详误请距车达过返连钟键长间际非预飞]+$",
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001F\\u007F]",
            "type": "string"
          }
        }
      ],
      "description": "Short display name, at most four glyphs. Only characters bundled in the current travel_font_18 are accepted; use a short ASCII code when unsupported."
    },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "service",
        "origin",
        "destination",
        "status",
        "planned_departure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 23,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "allOf": [
            {
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]",
                "type": "string"
              }
            }
          ],
          "description": "Unique stable ID including itinerary date and route, not only the service number."
        },
        "kind": {
          "type": "string",
          "enum": [
            "train",
            "flight"
          ]
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 7,
          "allOf": [
            {
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]",
                "type": "string"
              }
            }
          ],
          "description": "Service number; kind-specific patterns bound the large label width."
        },
        "origin": {
          "$ref": "#/$defs/display_name"
        },
        "destination": {
          "$ref": "#/$defs/display_name"
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "boarding",
            "delayed",
            "departed",
            "arrived",
            "cancelled",
            "unknown"
          ],
          "description": "Explicit provider-reported status. Never inferred solely from the clock."
        },
        "planned_departure": {
          "$ref": "#/$defs/timestamp"
        },
        "estimated_departure": {
          "$ref": "#/$defs/optional_timestamp"
        },
        "actual_departure": {
          "$ref": "#/$defs/optional_timestamp"
        },
        "planned_arrival": {
          "$ref": "#/$defs/optional_timestamp"
        },
        "gate": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 7,
          "pattern": "^[A-Za-z0-9-]+$",
          "allOf": [
            {
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]",
                "type": "string"
              }
            }
          ],
          "default": null
        },
        "seat": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 7,
          "pattern": "^[A-Z0-9车][A-Z0-9车 -]*$",
          "allOf": [
            {
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]",
                "type": "string"
              }
            }
          ],
          "default": null
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "train"
              }
            }
          },
          "then": {
            "properties": {
              "service": {
                "pattern": "^(?:[A-Z]{0,2}[0-9]{1,5}|[A-Z]{3}[0-9]{1,4}|[0-9]{6,7}|--)$"
              }
            }
          },
          "else": {
            "properties": {
              "service": {
                "pattern": "^(?:[A-Z0-9]{2}[0-9]{1,4}[A-Z]?|[A-Z]{3}[0-9]{1,4})$"
              }
            }
          }
        }
      ]
    }
  },
  "x-max-utf8-bytes": 4096,
  "x-semantic-rules": [
    "expires_at > updated_at",
    "Every trip id is unique",
    "planned_arrival is null/absent or >= planned_departure",
    "Within a source stream, revision strictly increases and updated_at never decreases",
    "Runtime clock validity and transport connectivity are local state, not trusted payload fields"
  ]
}
